# Build context of the root Dockerfile (source builds). The image needs Go
# sources with their embedded assets, frontend sources, third_party/README.md
# and scripts/build-binary.sh.
.git
.github
.claude
.generated
.vscode
.idea
bin
data
docs
config
# The frontend build checks bundled packages against third_party/README.md.
third_party/*
!third_party/README.md
AGENTS.md
README*.md
scripts/*
!scripts/build-binary.sh
# Rebuilt by the frontend stage; never mixed with the committed bundle.
internal/httpserver/web
**/node_modules
**/__pycache__
**/*.sqlite*
