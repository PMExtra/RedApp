+DOWNLOAD_DIR=$(mktemp -d "$DOWNLOAD_DIR/redapp.XXXXXXXX")
+trap 'rm -rf "$DOWNLOAD_DIR"' EXIT
+
+version="${TARGET:-latest}"
+if [ "$version" = latest ] || [ "$version" = stable ]; then
+    version=$(download_file "$DOWNLOAD_BASE_URL/$version")
+fi
 
 # Reject non-version content (e.g. an HTML error page) before it reaches the manifest URL
